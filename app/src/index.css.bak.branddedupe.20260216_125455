/* ===== BASE RESET (clean + valid) ===== */
* { box-sizing: border-box; }

html, body, #root {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  max-width: 100%;
}

body {
  background: #000;
  overflow: hidden; /* desktop: main handles scroll */
}

/* optional horizontal scroll helper (desktop) */
.hscroll {
  overflow-x: auto;
  overflow-y: hidden;
}
.hscroll::-webkit-scrollbar { display: none; }

/* hide horizontal scrollbar (Chrome/Safari) */
main::-webkit-scrollbar { display: none; }

/* ===== MOBILE FIX: stop iPhone jumble (horizontal overflow) ===== */
html, body, #root {
  max-width: 100%;
  overflow-x: hidden;
}

@media (max-width: 900px) {
  body { overflow: hidden; } /* keep body locked; main will scroll */

  main {
    width: 100%;
    flex-direction: column;   /* horizontal → vertical on phones */
    overflow-x: hidden;
    overflow-y: auto;
    scroll-snap-type: none;   /* snap breaks mobile */
  }

  section {
    width: 100%;
    min-height: calc(100vh - 120px);
    height: auto;
    flex: none;
  }
}
/* service card hover/press */
button[style*="serviceCard"], .serviceCard {
  /* (kept for future if we add a class) */
}

.serviceCardHover:hover {
  transform: translateY(-6px);
  border-color: rgba(125,211,252,0.35);
  background: rgba(255,255,255,0.08);
}

.serviceCardHover:active {
  transform: translateY(-2px) scale(0.99);
}

/* ✅ SERVICES: match the old look (4 across, responsive) */
.servicesGrid{
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  align-items: stretch;
}

/* laptop/tablet */
@media (max-width: 1100px){
  .servicesGrid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

/* phone */
@media (max-width: 640px){
  .servicesGrid{ grid-template-columns: 1fr; }
}

/* ✅ hover “jump” + press */
.serviceCardHover{
  transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
}
.serviceCardHover:hover{
  transform: translateY(-6px);
  border-color: rgba(125,211,252,0.35) !important;
  background: rgba(255,255,255,0.08) !important;
}
.serviceCardHover:active{
  transform: translateY(-2px) scale(0.99);
}

/* ✅ simple fade-in (no React libs) */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
.serviceCardFade{
  animation: fadeUp 420ms ease both;
}

@media (max-width: 900px){
  .aboutPills{ grid-template-columns: 1fr !important; }
}

.skillsGrid{
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

/* last row centered (2 cards) */
.skillsGrid > :nth-last-child(-n+2){
  grid-column: span 2;
}

/* tablet */
@media (max-width: 1100px){
  .skillsGrid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .skillsGrid > :nth-last-child(-n+2){ grid-column: auto; }
}

/* phone */
@media (max-width: 640px){
  .skillsGrid{ grid-template-columns: 1fr; }
}

