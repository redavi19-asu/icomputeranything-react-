/* ===== MOBILE AESTHETICS PATCH v1 =====
   Fixes: hero text clipped under fixed bars, crowded top-left brand,
   nav/pills overflow on iPhone. (CSS-only, mobile-only)
*/
@media (max-width: 520px) {

  /* 1) Make the fixed top bar smaller + safe-area aware */
  div[aria-label="Top bar"]{
    padding: calc(8px + env(safe-area-inset-top)) 10px 8px !important;
    height: auto !important;
    gap: 8px !important;
  }

  /* Make the brand block not smash the corner */
  div[aria-label="Top bar"] *{
    line-height: 1.1;
  }

  /* 2) Let the nav area scroll horizontally instead of wrapping ugly */
  div[aria-label="Top bar"] nav,
  div[aria-label="Top bar"] .nav,
  div[aria-label="Top bar"] [role="navigation"]{
    max-width: 100% !important;
    overflow-x: auto !important;
    white-space: nowrap !important;
    -webkit-overflow-scrolling: touch;
  }

  /* Slightly smaller buttons in the top bar */
  div[aria-label="Top bar"] button,
  div[aria-label="Top bar"] a{
    padding: 8px 10px !important;
    font-size: 14px !important;
  }

  /* 3) Ticker: keep it under the top bar and reduce its height */
  div[aria-label="Tech ticker"]{
    top: calc(52px + env(safe-area-inset-top)) !important;
    height: 54px !important;
  }

  /* 4) Push MAIN down so the hero headline is never clipped */
  main{
    margin-top: calc(106px + env(safe-area-inset-top)) !important; /* 52 + 54 */
    height: calc(100vh - (106px + env(safe-area-inset-top))) !important;
    overflow-x: hidden !important;
  }

  /* 5) Tighten hero typography so it fits iPhone */
  h1{
    font-size: clamp(26px, 7vw, 44px) !important;
    line-height: 1.05 !important;
    margin-top: 8px !important;
  }

  /* 6) Force any big “pill rows” to scroll instead of spilling */
  .pills,
  .pillRow,
  .chips,
  .chipRow{
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
  }
}
