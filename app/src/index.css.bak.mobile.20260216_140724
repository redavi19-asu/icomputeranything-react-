/* ===== DESKTOP HERO BRAND DEDUPE =====
   Avoids showing "I Computer Anything" twice on desktop.
   Mobile keeps hero label for clarity.
*/
@media (min-width: 900px) {
  .heroBadge,
  .heroLabel,
  .heroEyebrow {
    display: none !important;
  }
}
